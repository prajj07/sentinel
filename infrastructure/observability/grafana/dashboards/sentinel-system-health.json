{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "title": "Orders success rate",
      "type": "stat",
      "targets": [
        {
          "expr": "rate(orders_created_total[5m]) / (rate(orders_created_total[5m]) + rate(orders_failed_total[5m]) + 1e-9)",
          "legendFormat": "orders"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "title": "Payments success rate",
      "type": "stat",
      "targets": [
        {
          "expr": "rate(payments_total{status=\"SUCCESS\"}[5m]) / (rate(payments_total[5m]) + 1e-9)",
          "legendFormat": "payments"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "title": "Inventory reservation success",
      "type": "stat",
      "targets": [
        {
          "expr": "rate(inventory_reservations_total[5m]) / (rate(inventory_reservations_total[5m]) + rate(inventory_reservation_failures_total[5m]) + 1e-9)",
          "legendFormat": "inventory"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 4,
      "title": "Request rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (service) (rate(http_requests_total[1m]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 5,
      "title": "HTTP error rate (5xx)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (service) (rate(http_requests_total{status=~\"5..\"}[1m]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "id": 6,
      "title": "Dependency latency (p95)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, handler) (rate(http_request_duration_seconds_bucket{service=\"inventory\"}[5m])))",
          "legendFormat": "inventory {{handler}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, handler) (rate(http_request_duration_seconds_bucket{service=\"payments\"}[5m])))",
          "legendFormat": "payments {{handler}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(order_duration_seconds_bucket[5m])))",
          "legendFormat": "order workflow"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["sentinel", "sprint-2"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "title": "Sentinel — System Health",
  "uid": "sentinel-system-health",
  "version": 1
