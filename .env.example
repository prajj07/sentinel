# PostgreSQL
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://sentinel:sentinel@postgres:5432/sentinel

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
INVENTORY_CACHE_TTL_SECONDS=60

# RabbitMQ
RABBITMQ_USER=sentinel
RABBITMQ_PASSWORD=sentinel
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_URL=amqp://sentinel:sentinel@rabbitmq:5672/
RABBITMQ_EXCHANGE=sentinel.events

# Service URLs (Docker DNS names)
ORDERS_URL=http://orders:8001
INVENTORY_URL=http://inventory:8002
PAYMENTS_URL=http://payments:8003
NOTIFICATIONS_URL=http://notifications:8004

# HTTP timeouts (seconds)
HTTP_TIMEOUT_SECONDS=5.0
GATEWAY_HTTP_TIMEOUT_SECONDS=10.0

# OpenTelemetry / Tempo
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_ENABLED=true

# Grafana (local dev defaults)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Chaos engine (local/dev only — do not expose :8005 publicly)
CHAOS_ENABLED=true
CHAOS_URL=http://chaos:8005
